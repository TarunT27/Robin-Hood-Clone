# Copy to .env and fill in what you need. Everything is optional for local use.

# Defaults to a local SQLite file (dev.db) when unset.
# DATABASE_URL=postgresql://user:password@localhost/robinsock

# Set in production so logins survive restarts.
# SECRET_KEY=change-me

# Free key from https://finnhub.io for live quotes. Without one, or when
# Finnhub refuses a request, prices are simulated.
# FINNHUB_API_KEY=

# Set to "off" to show errors instead of simulated prices.
# MARKET_DATA_FALLBACK=simulated
